{
    "name": "FieldDocument",
    "type": "object",
    "properties": {
        "field_id": {
            "type": "string",
            "description": "Field the document belongs to"
        },
        "title": {
            "type": "string",
            "description": "Document title"
        },
        "doc_type": {
            "type": "string",
            "enum": [
                "soil_test",
                "lab_analysis",
                "land_record",
                "yield_record",
                "photo",
                "other"
            ],
            "enumColors": [
                "green",
                "blue",
                "purple",
                "yellow",
                "pink",
                "gray"
            ],
            "description": "Kind of document"
        },
        "file_uri": {
            "type": "string",
            "description": "Private storage reference"
        },
        "file_name": {
            "type": "string",
            "description": "Original file name"
        },
        "file_size_kb": {
            "type": "number",
            "description": "File size in kilobytes"
        },
        "document_date": {
            "type": "string",
            "format": "date",
            "description": "Date printed on the document"
        },
        "notes": {
            "type": "string",
            "description": "What the document shows"
        }
    },
    "required": [
        "field_id",
        "title",
        "file_uri"
    ],
    "rls": {
        "read": {
            "$or": [
                {
                    "created_by_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "create": {
            "created_by_id": "{{user.id}}"
        },
        "update": {
            "$or": [
                {
                    "created_by_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "delete": {
            "$or": [
                {
                    "created_by_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        }
    }
}