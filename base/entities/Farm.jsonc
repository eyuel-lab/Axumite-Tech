{
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "Farm name"
        },
        "description": {
            "type": "string",
            "description": "Short description of the holding"
        },
        "country": {
            "type": "string",
            "description": "Country"
        },
        "admin_area": {
            "type": "string",
            "description": "Region, zone or district"
        },
        "notes": {
            "type": "string",
            "description": "Free notes about the farm"
        }
    },
    "required": [
        "name"
    ],
    "rls": {
        "read": {
            "$or": [
                {
                    "created_by_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "create": {
            "created_by_id": "{{user.id}}"
        },
        "update": {
            "$or": [
                {
                    "created_by_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        },
        "delete": {
            "$or": [
                {
                    "created_by_id": "{{user.id}}"
                },
                {
                    "user_condition": {
                        "role": "admin"
                    }
                }
            ]
        }
    },
    "name": "Farm"
}